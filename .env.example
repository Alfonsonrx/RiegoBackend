# Copy to .env and fill in the empty values. Never put real values in this file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_riego
# Separate database for the tests: they wipe it on every run
TEST_DB_NAME=db_riego_test
DB_USER=
DB_PW=
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Web UI origins allowed to call the API (JSON list); leave it out to use these defaults
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
